{
  "manifest_version": 2,
  "name": "حصن — Hisn Link Shield",
  "version": "2.3.0",
  "description": "الإضافة الصامتة لهواتف Android: نقطة فحص ملونة (🟢/🟡/🔴) بجانب كل رابط قبل لمسه، مع جدار حجب للنطاقات الخطرة ووسم نتائج البحث — فحص محلي 100%.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "webNavigation", "tabs"],
  "background": {
    "scripts": ["rules/data.js", "rules/engine.js", "background/service-worker.js"],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_title": "حصن — جدار الفحص التلقائي",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["rules/data.js", "rules/engine.js", "content/content.js", "content/annotator.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": ["icons/*", "interstitial/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "hisn-shield@alzeedi1903-eng.github.io",
      "strict_min_version": "68.0"
    }
  }
}
