{
  "manifest_version": 3,
  "name": "حصن — Hisn Link Shield",
  "version": "2.3.0",
  "description": "جدار فحص تلقائي بين نقرة المستخدم والموقع الحقيقي: كشف المواقع المقلدة ومقارنتها بالرسمية قبل فتحها، مع حجب صلب على مستوى الشبكة ووضع سحابة اختياري.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "webNavigation", "tabs", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "حصن — جدار الفحص التلقائي",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["rules/data.js", "rules/engine.js", "content/content.js", "content/annotator.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "interstitial/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
