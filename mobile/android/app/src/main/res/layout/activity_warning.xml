<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة التحذير الحمراء الكاملة — تظهر فقط عند إيقاف رابط خبيث -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/warnRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="⚠️"
            android:textSize="52sp" />

        <TextView
            android:id="@+id/warnTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/warning_title"
            android:textColor="@color/hisn_red"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/warnHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:fontFamily="monospace"
            android:textColor="@color/hisn_blue"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/warnBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/warning_danger_body"
            android:textColor="@color/hisn_txt"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:id="@+id/warnScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/hisn_card"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/hisn_dim"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="أسباب التصنيف:"
            android:textColor="@color/hisn_dim"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/warnReasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp" />

        <Button
            android:id="@+id/btnOfficial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/hisn_blue"
            android:textColor="#0A0F1E"
            android:visibility="gone"
            android:text="@string/open_official" />

        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/hisn_amber"
            android:textColor="#1C1408"
            android:visibility="gone"
            android:text="@string/continue_risky" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/hisn_green"
            android:textColor="#F0FDF4"
            android:text="@string/go_back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="حصن أوقف هذا الرابط قبل أن يصل إلى المتصفح — لا تُدخل أي بيانات أو رموز تحقق على النطاق أعلاه."
            android:textColor="@color/hisn_dim"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>
