<?xml version="1.0" encoding="utf-8"?>
<!-- لوحة الإدارة الرئيسية — ScrollView بلا تبعيات خارجية -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hisn_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- الترويسة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="18dp">
            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_shield"
                android:contentDescription="حصن" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/hisn_txt"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="جدار فحص بين كل رابط وبين جهازك"
                    android:textColor="@color/hisn_dim"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- البديل 2: معترض الروابط -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/hisn_card"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_interceptor_title"
                android:textColor="@color/hisn_txt"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/statusInterceptor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="@string/default_browser_off"
                android:textColor="@color/hisn_amber"
                android:textSize="13sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="@string/card_interceptor_desc"
                android:textColor="@color/hisn_dim"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
            <Button
                android:id="@+id/btnSetDefault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/hisn_green"
                android:text="@string/btn_set_default"
                android:textColor="#F0FDF4" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <!-- البديل 3: مراقب الإشعارات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/hisn_card"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_notif_title"
                android:textColor="@color/hisn_txt"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/statusNotif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="@string/notif_access_off"
                android:textColor="@color/hisn_amber"
                android:textSize="13sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="@string/card_notif_desc"
                android:textColor="@color/hisn_dim"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
            <Button
                android:id="@+id/btnEnableNotif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/hisn_green"
                android:text="@string/btn_enable_notif"
                android:textColor="#F0FDF4" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <!-- الخادم السحابي -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/hisn_card"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/server_label"
                android:textColor="@color/hisn_txt"
                android:textSize="15sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/serverInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/server_hint"
                android:inputType="textUri"
                android:textColor="@color/hisn_txt"
                android:textColorHint="@color/hisn_dim"
                android:textSize="13sp" />
            <Button
                android:id="@+id/btnServerSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/hisn_line"
                android:text="@string/server_save"
                android:textColor="@color/hisn_txt" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <!-- فحص يدوي سريع -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/hisn_card"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_test_title"
                android:textColor="@color/hisn_txt"
                android:textSize="15sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/testInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/test_hint"
                android:inputType="textUri"
                android:textColor="@color/hisn_txt"
                android:textColorHint="@color/hisn_dim"
                android:textSize="13sp" />
            <Button
                android:id="@+id/btnTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/hisn_blue"
                android:text="@string/btn_test"
                android:textColor="#0A0F1E" />
            <TextView
                android:id="@+id/testResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textColor="@color/hisn_txt"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="الفحص السحابي يمر عبر خادمك فقط — وعند انقطاع الشبكة تعمل القواعد المحلية المدمجة.\nلا يقرأ حصن نص الرسائل ولا يخزن أي إشعار — يفحص الروابط وينسى."
            android:textColor="@color/hisn_dim"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>
