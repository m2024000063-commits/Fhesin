<?xml version="1.0" encoding="utf-8"?>
<!-- نافذة الفحص اللحظية — شفافة تظهر بضع مئات من المللي ثانية ثم تمرر الرابط -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/hisn_card"
        android:padding="26dp">

        <ProgressBar
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:indeterminateTint="@color/hisn_green" />

        <TextView
            android:id="@+id/scanStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/scanning"
            android:textColor="@color/hisn_txt"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="حصن — فحص قبل الفتح"
            android:textColor="@color/hisn_dim"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
